// ─── Control Database Schema ───────────────────────────────────────────────
// This schema is used by the single shared Control Database.
// It stores user accounts, branch metadata (including encrypted DB URLs),
// cross-branch permission grants, and central audit logs.
// Donor data lives ONLY in per-branch databases (see branch.schema.prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VOLUNTEER
}

// ─── Branch ────────────────────────────────────────────────────────────────
// Each branch row represents one independent PostgreSQL database.
// dbUrlEncrypted holds the AES-256-GCM-encrypted connection string.
// Donor/Donation data never touches this database.

model Branch {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  location         String?
  dbUrlEncrypted   String            // AES-256-GCM encrypted PostgreSQL URL
  dbStatus         String            @default("connected") // connected | unreachable | migrating
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  users            User[]
  permissionGrants PermissionGrant[]
  auditLogs        AuditLogCentral[]
}

// ─── User ──────────────────────────────────────────────────────────────────

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  passwordHash     String
  role             Role              @default(VOLUNTEER)
  permissions      Json?
  branchId         Int?
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive         Boolean           @default(true)
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  permissionGrants PermissionGrant[] @relation("UserGrants")
  grantedGrants    PermissionGrant[] @relation("GrantedByUser")
  centralLogs      AuditLogCentral[] @relation("CentralLogActor")

  @@index([branchId])
}

// ─── PermissionGrant ───────────────────────────────────────────────────────
// Maps a user to an additional branch they can switch into.
// A user with NO grant row for a branch must NEVER get a connection to that DB.

model PermissionGrant {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation("UserGrants", fields: [userId], references: [id], onDelete: Cascade)
  branchId           Int
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  accessLevel        String   @default("READ") // READ | WRITE | ADMIN
  grantedAt          DateTime @default(now())
  grantedByAdminId   Int?
  grantedByAdmin     User?    @relation("GrantedByUser", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

// ─── AuditLogCentral ───────────────────────────────────────────────────────
// Immutable record of SUPER_ADMIN-level actions (branch creation, credential
// reveals, cross-branch grants). Written to the Control DB, never to branch DBs.

model AuditLogCentral {
  id             Int      @id @default(autoincrement())
  actorId        Int?
  actor          User?    @relation("CentralLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  details        String
  targetBranchId Int?
  targetBranch   Branch?  @relation(fields: [targetBranchId], references: [id], onDelete: SetNull)
  timestamp      DateTime @default(now())
}