generator client {
  provider = "prisma-client-js"
  output   = "../generated/central"
}

datasource db {
  provider = "postgresql"
  url      = env("CENTRAL1_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCH
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id                Int          @id @default(autoincrement())
  name              String       @unique
  slug              String       @unique
  location          String?
  databaseUrlSecret String
  isActive          Boolean      @default(true)

  users             BranchUser[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPER ADMIN
// ─────────────────────────────────────────────────────────────────────────────

model SuperAdmin {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  qrToken      String?   @unique
  identity     UserIdentity?
  linkCodes    AccountLinkCode[]
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCH USER
// ─────────────────────────────────────────────────────────────────────────────

model BranchUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  qrToken      String?   @unique
  identity     UserIdentity?
  linkCodes    AccountLinkCode[]

  // ADMIN / COORDINATOR / VOLUNTEER
  role         String    @default("VOLUNTEER")

  // Custom permissions
  permissions  Json?

  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchId])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([isDeleted])
  @@index([qrToken])
}

// ─────────────────────────────────────────────────────────────────────────────
// PUSH SUBSCRIPTION (FCM tokens for staff push notifications)
// ─────────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id           Int       @id @default(autoincrement())

  userId       Int
  userType     String

  branchId     Int?

  fcmToken     String    @unique
  deviceInfo   String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([branchId])
}
// ─────────────────────────────────────────────────────────────────────────────
// CLERK IDENTITY MAPPING
// ─────────────────────────────────────────────────────────────────────────────

model UserIdentity {
  id           Int         @id @default(autoincrement())
  clerkUserId  String      @unique
  userType     String
  superAdminId Int?        @unique
  branchUserId Int?        @unique
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  branchUser   BranchUser? @relation(fields: [branchUserId], references: [id], onDelete: Cascade)
  linkedAt     DateTime    @default(now())
}

model AccountLinkCode {
  id           Int         @id @default(autoincrement())
  codeHash     String      @unique
  userType     String
  superAdminId Int?
  branchUserId Int?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  branchUser   BranchUser? @relation(fields: [branchUserId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime    @default(now())
}
