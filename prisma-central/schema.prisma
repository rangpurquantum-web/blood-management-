generator client {
  provider = "prisma-client-js"
  output   = "../generated/central"
}

datasource db {
  provider = "postgresql"
  url      = env("CENTRAL_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCH
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id                Int          @id @default(autoincrement())
  name              String       @unique
  slug              String       @unique
  location          String?
  databaseUrlSecret String
  isActive          Boolean      @default(true)

  users             BranchUser[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPER ADMIN
// ─────────────────────────────────────────────────────────────────────────────

model SuperAdmin {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCH USER
// ─────────────────────────────────────────────────────────────────────────────

model BranchUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String

  // ADMIN / COORDINATOR / VOLUNTEER
  role         String    @default("VOLUNTEER")

  // Custom permissions
  permissions  Json?

  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchId])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([isDeleted])
}

// ─────────────────────────────────────────────────────────────────────────────
// PUSH SUBSCRIPTION (FCM tokens for staff push notifications)
// ─────────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id           Int       @id @default(autoincrement())

  // Either a BranchUser or a SuperAdmin subscribes — store which + their id
  userId       Int
  userType     String    // "BRANCH_USER" | "SUPER_ADMIN"

  // For branch users, which branch they belong to (for scoping the
  // midnight per-branch digest). Null for super admins.
  branchId     Int?

  fcmToken     String    @unique
  deviceInfo   String?   // optional label, e.g. "Fahim's Redmi"

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([branchId])
}