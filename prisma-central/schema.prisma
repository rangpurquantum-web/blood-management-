generator client {
  provider = "prisma-client-js"
  output   = "../generated/central"
}

datasource db {
  provider = "postgresql"
  url      = env("CENTRAL_DATABASE_URL")
}

model Branch {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  slug              String   @unique
  location          String?
  databaseUrlSecret String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SuperAdmin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
