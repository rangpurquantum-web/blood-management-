# ─── Control Database ─────────────────────────────────────────────────────────
# The single small Control DB — stores user accounts, branch metadata,
# permission grants, and central audit logs. Never stores donor data.
CONTROL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qblood_control?schema=public"

# ─── Encryption ───────────────────────────────────────────────────────────────
# 64-char hex string (32 bytes) used to AES-256-GCM-encrypt branch DB URLs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars-generated-by-the-command-above-00000000000"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_URL="http://localhost:3000"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# NOTE: Branch databases are NOT configured here.
# They are added through the Super Admin UI and stored encrypted in the Control DB.
